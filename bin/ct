#!/usr/bin/env bash
# coding-team CLI v2 — platform-independent setup with explicit model-map actions.
#
#   ./bin/ct init                 # auto-detect platform and link adapter only
#   ./bin/ct map propose          # print a model-map proposal (no writes)
#   ./bin/ct map approve --yes    # explicitly approve and write declared outputs
#   ./bin/ct map decline          # record no map write (safe no-op)
#   ./bin/ct init --platform codex|cursor|cline
#   ./bin/ct init --full          # full Codex profile setup
#   ./bin/ct status | refresh | enable | disable | project | help
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROPOSE="$ROOT/scripts/propose-model-map.py"
QA_SKILL_SRC="$ROOT/skills/quality/qa-evidence-enforcement"
QA_VALIDATOR="$ROOT/scripts/validate-qa-evidence.rb"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CODEX_HOME="${CODEX_HOME/#\~/$HOME}"

die() { echo "error: $*" >&2; exit 1; }
[[ -f "$PROPOSE" ]] || die "missing $PROPOSE"
[[ -f "$QA_SKILL_SRC/SKILL.md" && -f "$QA_VALIDATOR" ]] || die "missing QA evidence enforcement assets"
chmod +x "$ROOT/bin/ct" "$PROPOSE" 2>/dev/null || true

usage() {
  cat <<'EOF'
coding-team v2 CLI (platform-independent)

  ./bin/ct init [--platform codex|cursor|cline] [--yes] [--full]
      Detect/install the adapter/QA skill only. Never reads or writes a map.
      --yes is accepted for compatibility but has no setup-side map authority.

  ./bin/ct status
  ./bin/ct map propose [--platform ...]
      Print a model-map proposal. Never writes a map.
  ./bin/ct map approve [--yes] [--platform ...]
      Explicitly approve the current proposal and write declared map outputs.
  ./bin/ct map decline [--platform ...]
      Decline mapping. Never writes or deletes a map.
  ./bin/ct refresh [--yes] [--platform ...]
      Compatibility alias for explicit map approval.
  ./bin/ct enable pm-lean[,agentic-worker]     (Codex addons)
  ./bin/ct disable pm-lean[,agentic-worker]
  ./bin/ct project <path>
  ./bin/ct help

Notes
  • Core policy has no host slugs — only abstract tiers.
  • Model map is a SUGGESTION until you approve (or pass --yes).
  • Default platform: auto-detect (Codex if ~/.codex exists, else ask).
EOF
}

detect_platform() {
  if [[ -d "$CODEX_HOME" ]]; then
    echo codex
    return
  fi
  if [[ -d "$HOME/.cursor" ]] || [[ -d "$ROOT/../../.cursor" ]]; then
    echo cursor
    return
  fi
  echo ""
}

link_path() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [[ -L "$dst" ]]; then
    local cur
    cur="$(readlink "$dst")"
    if [[ "$cur" == "$src" ]]; then
      echo "already linked: $dst"
      return 0
    fi
    rm "$dst"
  elif [[ -e "$dst" ]]; then
    die "refusing to overwrite non-symlink: $dst"
  fi
  ln -s "$src" "$dst"
  echo "linked: $dst → $src"
}

unlink_path() {
  local dst="$1"
  if [[ -L "$dst" ]]; then
    rm "$dst"
    echo "removed: $dst"
  fi
}

install_adapter() {
  local platform="$1"
  case "$platform" in
    codex)
      link_path "$ROOT/adapters/codex" "$CODEX_HOME/skills/coding-team"
      link_path "$QA_SKILL_SRC" "$CODEX_HOME/skills/qa-evidence-enforcement"
      ;;
    cursor)
      mkdir -p "$ROOT/.cursor-install"
      link_path "$ROOT/adapters/cursor" "$ROOT/.cursor-install/coding-team"
      echo "Cursor: symlink ready at $ROOT/.cursor-install/coding-team"
      echo "Copy/link into your project: .cursor/skills/coding-team → that path"
      echo "  or: ln -s \"$ROOT/adapters/cursor\" \"/path/to/project/.cursor/skills/coding-team\""
      ;;
    cline)
      mkdir -p "$ROOT/.cline-install"
      link_path "$ROOT/adapters/cline" "$ROOT/.cline-install/coding-team"
      echo "Cline: symlink ready at $ROOT/.cline-install/coding-team"
      echo "Point Cline skills/rules at CODING_TEAM_ROOT=$ROOT"
      ;;
    *)
      die "unknown platform: $platform"
      ;;
  esac
}

map_outs() {
  local platform="$1"
  case "$platform" in
    codex)
      echo "$CODEX_HOME/skills/coding-team/model-pool.map.md"
      echo "$ROOT/adapters/codex/model-pool.map.md"
      echo "$ROOT/examples/model-pool.map.md"
      ;;
    cursor)
      echo "$ROOT/adapters/cursor/model-pool.map.md"
      echo "$ROOT/examples/model-pool.map.md"
      ;;
    cline)
      echo "$ROOT/adapters/cline/model-pool.map.md"
      echo "$ROOT/examples/model-pool.map.md"
      ;;
  esac
}

run_propose() {
  local platform="$1"
  shift
  local outs=()
  local o
  while IFS= read -r o; do
    [[ -n "$o" ]] && outs+=("$o")
  done < <(map_outs "$platform")
  local args=(--platform "$platform" --codex-home "$CODEX_HOME")
  if [[ "${#outs[@]}" -gt 0 ]]; then
    for o in "${outs[@]}"; do
      args+=(--out "$o")
    done
  fi
  if [[ "$#" -gt 0 ]]; then
    args+=("$@")
  fi
  python3 "$PROPOSE" "${args[@]}"
}

cmd_init() {
  local platform="" yes=0 full=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --platform)
        platform="$2"
        shift 2
        ;;
      --yes|-y)
        yes=1
        shift
        ;;
      --full|-f)
        full=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown init flag: $1"
        ;;
    esac
  done

  if [[ -z "$platform" ]]; then
    platform="$(detect_platform)"
    if [[ -z "$platform" ]]; then
      if [[ -t 0 ]]; then
        echo "Which platform? [codex/cursor/cline]"
        read -r platform
      else
        die "cannot auto-detect platform; pass --platform codex|cursor|cline"
      fi
    else
      echo "Auto-detected platform: $platform"
    fi
  fi

  echo "==> coding-team v2 init (platform=$platform)"
  install_adapter "$platform"

  if [[ "$yes" -eq 1 ]]; then
    echo "note: --yes does not approve a model map during setup; use './bin/ct map approve --yes' explicitly."
  fi

  if [[ "$full" -eq 1 ]]; then
    if [[ "$platform" != "codex" ]]; then
      echo "note: --full addons currently Codex-only; skipped for $platform"
    else
      echo "Full profile does not enable addons automatically. Use './bin/ct enable …' explicitly."
    fi
  fi

  echo
  echo "Done. Set CODING_TEAM_ROOT=$ROOT when prompting your agent."
  echo "Model map: NOT_STARTED (run './bin/ct map propose' then './bin/ct map approve')."
  echo "Check: ./bin/ct status"
}

cmd_status() {
  echo "CODING_TEAM_ROOT: $ROOT"
  echo "CODEX_HOME:       $CODEX_HOME"
  echo
  echo "Adapters / skills:"
  for name in coding-team qa-evidence-enforcement agentic-worker; do
    local p="$CODEX_HOME/skills/$name"
    if [[ -L "$p" ]]; then
      echo "  Codex $name → $(readlink "$p")"
    fi
  done
  echo "  QA validator: $QA_VALIDATOR"
  for p in \
    "$ROOT/adapters/codex/model-pool.map.md" \
    "$ROOT/adapters/cursor/model-pool.map.md" \
    "$ROOT/adapters/cline/model-pool.map.md" \
    "$CODEX_HOME/skills/coding-team/model-pool.map.md"; do
    if [[ -f "$p" ]]; then
      echo "  map: $p"
      if rg -q "Status: \*\*proposal" "$p" 2>/dev/null; then
        echo "       (proposal — not approved?)"
      elif rg -q "Status: \*\*approved" "$p" 2>/dev/null; then
        echo "       (approved)"
      fi
    fi
  done
  if [[ -f "$ROOT/addons/toggles.json" ]]; then
    echo
    echo "Addons:"
    python3 -c "import json;d=json.load(open('$ROOT/addons/toggles.json'));
[print(f\"  {k}: {'ON' if v.get('enabled') else 'OFF'}\") for k,v in d.get('addons',{}).items()]"
    if [[ -f "$ROOT/addons/agentic-worker/VERSION" ]]; then
      echo "  agentic-worker version: $(tr -d '[:space:]' < "$ROOT/addons/agentic-worker/VERSION")"
    fi
  fi
}

cmd_refresh() {
  local platform="" yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --platform) platform="$2"; shift 2 ;;
      --yes|-y) yes=1; shift ;;
      *) die "unknown refresh flag: $1" ;;
    esac
  done
  [[ -n "$platform" ]] || platform="$(detect_platform)"
  [[ -n "$platform" ]] || die "pass --platform"
  if [[ "$yes" -eq 1 ]]; then
    run_propose "$platform" --yes
  else
    run_propose "$platform"
  fi
}

cmd_map_propose() {
  local platform=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --platform) [[ $# -ge 2 ]] || die "--platform requires a value"; platform="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown map propose flag: $1" ;;
    esac
  done
  [[ -n "$platform" ]] || platform="$(detect_platform)"
  [[ -n "$platform" ]] || die "pass --platform"
  echo "==> Model map proposal (no files will be written)"
  run_propose "$platform" --propose-only
}

cmd_map_approve() {
  local platform="" yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --platform) [[ $# -ge 2 ]] || die "--platform requires a value"; platform="$2"; shift 2 ;;
      --yes|-y) yes=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown map approve flag: $1" ;;
    esac
  done
  [[ -n "$platform" ]] || platform="$(detect_platform)"
  [[ -n "$platform" ]] || die "pass --platform"
  echo "==> Explicit model map approval (declared outputs only)"
  if [[ "$yes" -eq 1 ]]; then
    run_propose "$platform" --yes
  else
    run_propose "$platform"
  fi
}

cmd_map_decline() {
  local platform=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --platform) [[ $# -ge 2 ]] || die "--platform requires a value"; platform="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown map decline flag: $1" ;;
    esac
  done
  [[ -n "$platform" ]] || platform="$(detect_platform)"
  [[ -n "$platform" ]] || die "pass --platform"
  echo "Model map declined for $platform; no files written or deleted."
}

cmd_map() {
  local action="${1:-propose}"
  if [[ $# -gt 0 ]]; then shift; fi
  case "$action" in
    propose) cmd_map_propose "$@" ;;
    approve) cmd_map_approve "$@" ;;
    decline) cmd_map_decline "$@" ;;
    status) cmd_status "$@" ;;
    *) die "unknown map action: $action (use propose, approve, decline, or status)" ;;
  esac
}

set_toggle() {
  local name="$1" enabled="$2"
  python3 - "$ROOT/addons/toggles.json" "$name" "$enabled" <<'PY'
import json, sys
path, name, enabled = sys.argv[1], sys.argv[2], sys.argv[3].lower() == "true"
data = json.loads(open(path, encoding="utf-8").read())
addons = data.setdefault("addons", {})
if name not in addons:
    sys.exit(f"unknown addon: {name}")
addons[name]["enabled"] = enabled
open(path, "w", encoding="utf-8").write(json.dumps(data, indent=2) + "\n")
print(f"toggles: {name} = {enabled}")
PY
}

cmd_enable() {
  local csv="${1:-}"
  [[ -n "$csv" ]] || die "usage: ct enable pm-lean[,agentic-worker]"
  IFS=',' read -ra names <<<"$csv"
  for name in "${names[@]}"; do
    name="$(echo "$name" | tr -d '[:space:]')"
    case "$name" in
      pm-lean)
        set_toggle pm-lean true
        link_path "$ROOT/addons/pm-lean/skills/pm-lean-assumption-triage" "$CODEX_HOME/skills/pm-lean-assumption-triage"
        link_path "$ROOT/addons/pm-lean/skills/pm-lean-experiment-design" "$CODEX_HOME/skills/pm-lean-experiment-design"
        ;;
      agentic-worker)
        set_toggle agentic-worker true
        link_path "$ROOT/addons/agentic-worker/skills/agentic-worker" "$CODEX_HOME/skills/agentic-worker"
        ;;
      *) die "unknown addon: $name" ;;
    esac
  done
}

cmd_disable() {
  local csv="${1:-}"
  [[ -n "$csv" ]] || die "usage: ct disable pm-lean[,agentic-worker]"
  IFS=',' read -ra names <<<"$csv"
  for name in "${names[@]}"; do
    name="$(echo "$name" | tr -d '[:space:]')"
    case "$name" in
      pm-lean)
        set_toggle pm-lean false
        unlink_path "$CODEX_HOME/skills/pm-lean-assumption-triage"
        unlink_path "$CODEX_HOME/skills/pm-lean-experiment-design"
        ;;
      agentic-worker)
        set_toggle agentic-worker false
        unlink_path "$CODEX_HOME/skills/agentic-worker"
        ;;
      *) die "unknown addon: $name" ;;
    esac
  done
}

cmd_project() {
  local project="${1:-}"
  [[ -d "$project" ]] || die "not a directory: $project"
  local agents="$project/AGENTS.md"
  local marker="<!-- coding-team:begin -->"
  if [[ -f "$agents" ]] && grep -q 'coding-team:begin' "$agents"; then
    echo "AGENTS.md already has coding-team pointer"
    return 0
  fi
  cat >>"$agents" <<BLOCK

${marker}
## Coding Team

\`CODING_TEAM_ROOT=${ROOT}\`

1. Load coding-team skill for your platform (Codex / Cursor / Cline adapter).
2. Read \`core/\` + approved \`model-pool.map.md\`.
3. WIP ≤ 2; TE → Gatekeeper sequential; incomplete → ask human.
4. Addons default OFF — \`./bin/ct enable …\` if needed.
<!-- coding-team:end -->
BLOCK
  echo "updated $agents"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    ""|help|-h|--help) usage ;;
    init|install|setup) cmd_init "$@" ;;
    status|st) cmd_status ;;
    refresh) cmd_refresh "$@" ;;
    map) cmd_map "$@" ;;
    map.propose) cmd_map_propose "$@" ;;
    map.approve) cmd_map_approve "$@" ;;
    map.decline) cmd_map_decline "$@" ;;
    enable|on) cmd_enable "$@" ;;
    disable|off) cmd_disable "$@" ;;
    project) cmd_project "$@" ;;
    *) die "unknown command: $cmd (try ./bin/ct help)" ;;
  esac
}

main "$@"
