#!/usr/bin/env bash
# coding-team CLI — platform-independent install with explicit model-map control.
#
#   ./bin/ct init                 # install adapter only
#   ./bin/ct init --platform codex|cursor|cline
#   ./bin/ct map propose         # read-only model-map suggestion
#   ./bin/ct map approve         # explicit model-map write
#   ./bin/ct status | refresh | enable | disable | project | help
#   ./bin/ct tools terminal ...
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROPOSE="$ROOT/scripts/propose-model-map.py"
QA_SKILL_SRC="$ROOT/skills/quality/qa-evidence-enforcement"
QA_VALIDATOR="$ROOT/scripts/validate-qa-evidence.rb"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CODEX_HOME="${CODEX_HOME/#\~/$HOME}"

die() { echo "error: $*" >&2; exit 1; }
[[ -f "$PROPOSE" ]] || die "missing $PROPOSE"
[[ -f "$QA_SKILL_SRC/SKILL.md" && -f "$QA_VALIDATOR" ]] || die "missing QA evidence enforcement assets"
chmod +x "$ROOT/bin/ct" "$PROPOSE" 2>/dev/null || true

usage() {
  cat <<'EOF'
coding-team v2 CLI (platform-independent)

  ./bin/ct init [--platform codex|cursor|cline]
      Detect/install the selected adapter only.

  ./bin/ct map propose [--platform codex|cursor|cline]
      Show a read-only host model-map suggestion. Never writes a file.

  ./bin/ct map approve [--platform codex|cursor|cline] [--yes]
      Show the suggestion and explicitly approve a local model-map write.

  ./bin/ct status
  ./bin/ct refresh [--platform ...]       (legacy alias for map propose)
  ./bin/ct enable pm-lean                (optional PM addon)
  ./bin/ct disable pm-lean
  ./bin/ct project <path>
  ./bin/ct tools terminal --timeout-s <seconds> -- <command> [args...]
      Run the retained bounded compact-terminal tool. Quantizer, guard, and
      rollback integration were disposed after no net token benefit.
  ./bin/ct help

Notes
  • Core policy has no host slugs — only abstract tiers.
  • Installation does not write a model map.
  • map propose is read-only; map approve is the only write path.
  • Default platform: auto-detect (Codex if ~/.codex exists, else ask).
EOF
}

detect_platform() {
  if [[ -d "$CODEX_HOME" ]]; then
    echo codex
    return
  fi
  if [[ -d "$HOME/.cursor" ]] || [[ -d "$ROOT/../../.cursor" ]]; then
    echo cursor
    return
  fi
  if [[ -n "${CLINE_HOME:-}" ]] || [[ -d "$HOME/.cline" ]]; then
    echo cline
    return
  fi
  echo ""
}

link_path() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [[ -L "$dst" ]]; then
    local cur
    cur="$(readlink "$dst")"
    if [[ "$cur" == "$src" ]]; then
      echo "already linked: $dst"
      return 0
    fi
    rm "$dst"
  elif [[ -e "$dst" ]]; then
    die "refusing to overwrite non-symlink: $dst"
  fi
  ln -s "$src" "$dst"
  echo "linked: $dst → $src"
}

unlink_path() {
  local dst="$1"
  if [[ -L "$dst" ]]; then
    rm "$dst"
    echo "removed: $dst"
  fi
}

map_outs() {
  local platform="$1"
  case "$platform" in
    codex)
      echo "$CODEX_HOME/skills/coding-team/model-pool.map.md"
      echo "$ROOT/adapters/codex/model-pool.map.md"
      echo "$ROOT/examples/model-pool.map.md"
      ;;
    cursor)
      echo "$ROOT/adapters/cursor/model-pool.map.md"
      echo "$ROOT/examples/model-pool.map.md"
      ;;
    cline)
      echo "$ROOT/adapters/cline/model-pool.map.md"
      echo "$ROOT/examples/model-pool.map.md"
      ;;
  esac
}

run_propose() {
  local platform="$1"
  shift
  python3 "$PROPOSE" --platform "$platform" --codex-home "$CODEX_HOME" --propose-only "$@"
}

run_approve() {
  local platform="$1"
  shift
  local outs=()
  local o
  while IFS= read -r o; do
    [[ -n "$o" ]] && outs+=(--out "$o")
  done < <(map_outs "$platform")
  python3 "$PROPOSE" --platform "$platform" --codex-home "$CODEX_HOME" "${outs[@]}" "$@"
}

cmd_init() {
  local platform=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --platform)
        platform="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "unknown init flag: $1"
        ;;
    esac
  done

  if [[ -z "$platform" ]]; then
    platform="$(detect_platform)"
    if [[ -z "$platform" ]]; then
      if [[ -t 0 ]]; then
        echo "Which platform? [codex/cursor/cline]"
        read -r platform
      else
        die "cannot auto-detect platform; pass --platform codex|cursor|cline"
      fi
    else
      echo "Auto-detected platform: $platform"
    fi
  fi

  echo "==> coding-team init (platform=$platform)"
  "$ROOT/scripts/install-coding-team.sh" --platform "$platform"

  echo
  echo "Done. No model map was written and no project source root was pinned."
  echo "Check: ./bin/ct status"
}

cmd_status() {
  echo "CODING_TEAM_ROOT: $ROOT"
  echo "CODEX_HOME:       $CODEX_HOME"
  echo
  echo "Adapters / skills:"
  for name in coding-team qa-evidence-enforcement pm-lean-assumption-triage pm-lean-experiment-design; do
    local p="$CODEX_HOME/skills/$name"
    if [[ -L "$p" ]]; then
      echo "  Codex $name → $(readlink "$p")"
    fi
  done
  echo "  QA validator: $QA_VALIDATOR"
  for p in \
    "$ROOT/adapters/codex/model-pool.map.md" \
    "$ROOT/adapters/cursor/model-pool.map.md" \
    "$ROOT/adapters/cline/model-pool.map.md" \
    "$CODEX_HOME/skills/coding-team/model-pool.map.md"; do
    if [[ -f "$p" ]]; then
      echo "  map: $p"
      if rg -q "Status: \*\*proposal" "$p" 2>/dev/null; then
        echo "       (proposal — not approved?)"
      elif rg -q "Status: \*\*approved" "$p" 2>/dev/null; then
        echo "       (approved)"
      fi
    fi
  done
  if [[ -f "$ROOT/addons/toggles.json" ]]; then
    echo
    echo "Addons:"
    python3 -c "import json;d=json.load(open('$ROOT/addons/toggles.json'));
[print(f\"  {k}: {'ON' if v.get('enabled') else 'OFF'}\") for k,v in d.get('addons',{}).items()]"
  fi
}

cmd_refresh() {
  local platform="" yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --platform) platform="$2"; shift 2 ;;
      --yes|-y) yes=1; shift ;;
      *) die "unknown refresh flag: $1" ;;
    esac
  done
  [[ -n "$platform" ]] || platform="$(detect_platform)"
  [[ -n "$platform" ]] || die "pass --platform"
  [[ "$yes" -eq 1 ]] && echo "note: --yes is ignored; refresh is read-only"
  run_propose "$platform"
}

cmd_map() {
  local action="${1:-}"
  shift || true
  case "$action" in
    propose)
      local platform=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --platform) platform="$2"; shift 2 ;;
          *) die "unknown map propose flag: $1" ;;
        esac
      done
      [[ -n "$platform" ]] || platform="$(detect_platform)"
      [[ -n "$platform" ]] || die "pass --platform"
      run_propose "$platform"
      ;;
    approve)
      local platform="" yes=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --platform) platform="$2"; shift 2 ;;
          --yes|-y) yes=1; shift ;;
          *) die "unknown map approve flag: $1" ;;
        esac
      done
      [[ -n "$platform" ]] || platform="$(detect_platform)"
      [[ -n "$platform" ]] || die "pass --platform"
      local extra=()
      [[ "$yes" -eq 1 ]] && extra+=(--yes)
      run_approve "$platform" "${extra[@]}"
      ;;
    *)
      die "usage: ./bin/ct map propose|approve [--platform ...]"
      ;;
  esac
}

set_toggle() {
  local name="$1" enabled="$2"
  python3 - "$ROOT/addons/toggles.json" "$name" "$enabled" <<'PY'
import json, sys
path, name, enabled = sys.argv[1], sys.argv[2], sys.argv[3].lower() == "true"
data = json.loads(open(path, encoding="utf-8").read())
addons = data.setdefault("addons", {})
if name not in addons:
    sys.exit(f"unknown addon: {name}")
addons[name]["enabled"] = enabled
open(path, "w", encoding="utf-8").write(json.dumps(data, indent=2) + "\n")
print(f"toggles: {name} = {enabled}")
PY
}

cmd_enable() {
  local csv="${1:-}"
  [[ -n "$csv" ]] || die "usage: ct enable pm-lean"
  IFS=',' read -ra names <<<"$csv"
  for name in "${names[@]}"; do
    name="$(echo "$name" | tr -d '[:space:]')"
    case "$name" in
      pm-lean)
        set_toggle pm-lean true
        link_path "$ROOT/addons/pm-lean/skills/pm-lean-assumption-triage" "$CODEX_HOME/skills/pm-lean-assumption-triage"
        link_path "$ROOT/addons/pm-lean/skills/pm-lean-experiment-design" "$CODEX_HOME/skills/pm-lean-experiment-design"
        ;;
      *) die "unknown addon: $name" ;;
    esac
  done
}

cmd_disable() {
  local csv="${1:-}"
  [[ -n "$csv" ]] || die "usage: ct disable pm-lean"
  IFS=',' read -ra names <<<"$csv"
  for name in "${names[@]}"; do
    name="$(echo "$name" | tr -d '[:space:]')"
    case "$name" in
      pm-lean)
        set_toggle pm-lean false
        unlink_path "$CODEX_HOME/skills/pm-lean-assumption-triage"
        unlink_path "$CODEX_HOME/skills/pm-lean-experiment-design"
        ;;
      *) die "unknown addon: $name" ;;
    esac
  done
}

cmd_project() {
  local project="${1:-}"
  [[ -d "$project" ]] || die "not a directory: $project"
  local agents="$project/AGENTS.md"
  local marker="<!-- coding-team:begin -->"
  python3 - "$agents" <<'PY'
import os
import sys
import tempfile
from pathlib import Path

path = Path(sys.argv[1])
start = "<!-- coding-team:begin -->"
end = "<!-- coding-team:end -->"
block = """<!-- coding-team:begin -->
## Coding Team

1. Load the active installed coding-team skill for the host.
2. For ordinary project work, use the installed root returned by its receipt check. Ignore ambient `CODING_TEAM_ROOT` and project-local `coding-team/` checkouts.
3. Use a source checkout only when the task explicitly changes Coding Team itself; validate that release candidate once before installation.
4. Validate this project's candidate; do not rerun framework tests or attach framework-wide path counts.
5. WIP <= 2; Test Engineer then Gatekeeper when the active policy requires them.
<!-- coding-team:end -->"""
text = path.read_text(encoding="utf-8") if path.exists() else ""
if start in text and end in text:
    before, rest = text.split(start, 1)
    _, after = rest.split(end, 1)
    updated = before.rstrip() + "\n\n" + block + after
else:
    updated = text.rstrip() + "\n\n" + block + "\n"
path.parent.mkdir(parents=True, exist_ok=True)
descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
try:
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        handle.write(updated)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
  echo "updated installed-version Coding Team pointer in $agents"
}

cmd_tools() {
  [[ $# -gt 0 ]] || die "usage: ./bin/ct tools <action> ..."
  exec python3 "$ROOT/adapters/codex/tool_cli.py" "$@"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    ""|help|-h|--help) usage ;;
    init|install|setup) cmd_init "$@" ;;
    status|st) cmd_status ;;
    refresh) cmd_refresh "$@" ;;
    map) cmd_map "$@" ;;
    enable|on) cmd_enable "$@" ;;
    disable|off) cmd_disable "$@" ;;
    project) cmd_project "$@" ;;
    tools) cmd_tools "$@" ;;
    *) die "unknown command: $cmd (try ./bin/ct help)" ;;
  esac
}

main "$@"
