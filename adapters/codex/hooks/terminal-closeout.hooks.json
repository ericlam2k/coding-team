{
  "description": "Optional Coding Team terminal-closeout guard for Codex projects that declare coding-team:begin.",
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__CODING_TEAM_ROOT__/adapters/codex/scripts/terminal-closeout-subagent-stop.py\"",
            "timeout": 10,
            "statusMessage": "Checking Coding Team terminal closeout"
          }
        ]
      }
    ]
  }
}
